---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { projectExcerpt } from '../lib/projects';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="py-20 px-4" aria-labelledby="projects-heading">
  <div class="max-w-7xl mx-auto">
    <h2 id="projects-heading" class="text-4xl md:text-5xl font-bold text-center mb-12 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent reveal">
      <span data-i18n="projects.title">Proyectos</span>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {projects.map((project) => (
        <ProjectCard
          slug={project.id}
          summaryEs={project.data.summaryEs ?? projectExcerpt(project.data.descriptionEs)}
          summaryEn={project.data.summaryEn ?? projectExcerpt(project.data.descriptionEn)}
          {...project.data}
        />
      ))}
    </div>
  </div>
</section>
