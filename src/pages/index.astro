---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Footer from '../components/Footer.astro';
import { buildHomeJsonLd } from '../lib/seo';

const pageTitle = 'Jorge Leal | Portafolio — Ingeniero de Software y Datos';
const pageDescription =
  'Portafolio oficial de Jorge Leal en jorgelealdev.com: ingeniero de software, análisis de datos, Astro, FastAPI y proyectos en producción. Descarga CV y conoce Databoard, PixMinder y más.';
const jsonLd = buildHomeJsonLd(pageDescription);
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <Navbar />
  <main>
    <Hero />
    <ProjectGrid />
  </main>
  <Footer />
</Layout>
