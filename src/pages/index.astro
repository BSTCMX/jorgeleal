---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import Footer from '../components/Footer.astro';
import { buildHomeJsonLd } from '../lib/seo';

const pageTitle = 'Jorge Leal | Ingeniero de software';
const pageDescription =
  'Portafolio oficial de Jorge Leal: ingeniero de software, análisis de datos y proyectos en producción. CV descargable en jorgelealdev.com.';
const jsonLd = buildHomeJsonLd(pageDescription);
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <Navbar />
  <main>
    <Hero />
    <ProjectGrid />
  </main>
  <Footer />
</Layout>
